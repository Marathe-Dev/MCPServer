  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^4.22.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.5.12",
    "typescript": "^7.0.2"
  }
