                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="PopupWindowCloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource PopupWindowCloseButtonBackground}" />
            <Setter Property="ToolTip" Value="Close" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Image x:Name="PopupWindowCloseImg"
                                   Source="{DynamicResource CloseIconDI}"
                                   Height="13" Width="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PopupWindowCloseImg" Property="Source" Value="{DynamicResource CloseIconHoverDI}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PopupWindowCloseButtonHover}" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopupWindowMinButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTip" Value="Minimize" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <TextBlock Text="&#x2013;" FontSize="15" Foreground="#5F6368"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5EEF9" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="15,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Source="{DynamicResource RPCProduct_logoDrawingImage}"
                   Width="28" Height="28"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="Windows MCP Tool Service"
                       Style="{StaticResource SectionHeader}"
                       FontSize="16" Margin="2,0,0,0"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="26" Height="24" Style="{StaticResource PopupWindowMinButtonStyle}" Click="Minimize_Click" />
                <Button Width="26" Height="24" Margin="4,0,0,0" Style="{StaticResource PopupWindowCloseButtonStyle}" Click="Cancel_Click" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource PopupWindowTopGridBorder}"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,15,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Connection" Style="{StaticResource SectionHeader}" />

                <TextBlock Grid.Row="1" Text="Cloud URL" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                <TextBox x:Name="cloud" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                         Style="{StaticResource PopupWindowNameStyle}" />

                <TextBlock Grid.Row="2" Text="Device ID" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                <PasswordBox x:Name="deviceId" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                             Style="{StaticResource PopupWindowPasswordStyle}" />

                <TextBlock Grid.Row="3" Text="Device name" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                <TextBox x:Name="name" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                         Style="{StaticResource PopupWindowNameStyle}" />

                <Separator Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Divider}" />

                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="Options" Style="{StaticResource SectionHeader}" />

                <CheckBox x:Name="enableCmd" Grid.Row="6" Grid.ColumnSpan="2"
                          Content="Allow remote CMD execution"
                          Style="{StaticResource CheckBoxStyle}"
                          Margin="0,2,0,6" Checked="EnableCmd_Checked" />
                <CheckBox x:Name="autoConnect" Grid.Row="7" Grid.ColumnSpan="2"
                          Content="Connect on startup"
                          Style="{StaticResource CheckBoxStyle}"
                          Margin="0,2,0,0" />

                <Separator Grid.Row="8" Grid.ColumnSpan="2" Style="{StaticResource Divider}" />

                <Grid Grid.Row="9" Grid.ColumnSpan="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Activity" Style="{StaticResource SectionHeader}" Margin="0" />
                    <TextBlock x:Name="state" Grid.Column="1" Text="Stopped"
                               FontWeight="SemiBold" Foreground="{StaticResource ButtonBackground}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <TextBox x:Name="activity" Grid.Row="10" Grid.ColumnSpan="2"
                         Style="{StaticResource LogBoxStyle}" />
            </Grid>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="2"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,7,7"
                BorderBrush="{StaticResource PopupWindowCenterGridBorder}"
                Background="{StaticResource PopupWindowBottomGridBackground}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                <Button x:Name="connect" Content="Connect"
                        IsDefault="True"
                        Style="{StaticResource OKButtonStyle}"
                        Margin="0,0,10,0" Click="Connect_Click" />
                <Button x:Name="disconnect" Content="Disconnect"
                        IsEnabled="False"
                        Style="{StaticResource CancelButtonStyle}"
                        Click="Disconnect_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>