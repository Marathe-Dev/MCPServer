                                <GeometryDrawing Geometry="F1 M43,43z M0,0z M1251.464,201.76A6.233,6.233,0,0,1,1261.577,196.88A6.52,6.52,0,1,0,1253.366,206.241A6.215,6.215,0,0,1,1251.464,201.76z">
                                    <GeometryDrawing.Brush>
                                        <LinearGradientBrush StartPoint="0.5,0.5" EndPoint="0.5,1.468" MappingMode="RelativeToBoundingBox"  Opacity="1">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.7" />
