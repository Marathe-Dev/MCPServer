                                    <GeometryDrawing.Brush>
                                        <LinearGradientBrush StartPoint="0.5,0.5" EndPoint="0.5,1.5" MappingMode="RelativeToBoundingBox" SpreadMethod="Pad" Opacity="1">
                                            <GradientStop Color="#FF3FC6FF" Offset="0" />
